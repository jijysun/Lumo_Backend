# ─────────────────────────────────────────────────────────────
# Lumo Backend 환경변수 템플릿
#   cp .env.example .env  후 값을 채운다. .env 는 커밋되지 않는다.
#
# ⚠️ 실배포의 .env 는 배포마다 .github/workflows/workflow.yml 이
#    GitHub Secrets 로 통째로 덮어쓴다. 서버에서 직접 수정하지 말 것.
#    측정 회차용 임시 변수는 .env 가 아니라 셸 환경변수로 주입한다.
# ─────────────────────────────────────────────────────────────

# ── Database (application.yaml) ──────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_NAME=lumo
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ── Redis (application.yaml) ─────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Mail (application.yaml / docker-compose.yml) ─────────────
# 측정 시에는 Mailpit 을 쓴다 → MAIL_SENDER_HOST=mailpit, SPRING_MAIL_PORT=1025
# (docker compose --profile measure up -d mailpit)
MAIL_SENDER_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
MAIL_SENDER_USERNAME=
MAIL_SENDER_PASSWORD=

# ── JWT (application.yaml) ───────────────────────────────────
# ⚠️ JWTProvider 가 이 값을 Base64 "인코딩" 해서 서명키로 쓴다(IMPROVEMENT_PLAN C-4).
#    HS256 은 256bit 이상을 요구하므로 인코딩 후 32바이트 이상이어야 하고,
#    그러려면 원문이 최소 24자여야 한다. 더 짧으면 기동 시 WeakKeyException 이 난다.
#    (C-4 수정 후에는 "Base64 디코딩" 으로 바뀌므로 규칙도 함께 바뀐다)
JWT_SECRET_KEY=

# ── OpenAI (domain/todo/service/ToDoService) ─────────────────
OPENAI_API_KEY=

# ── 컨테이너 이미지 (docker-compose.yml) ─────────────────────
# 대조군 재현 배포 시 커밋 SHA 태그를 지정한다
#   LUMO_TAG=ctrl-7a28965 sudo -E docker compose up -d Blue
LUMO_IMAGE=jijysun/lumo
LUMO_TAG=latest

# ─────────────────────────────────────────────────────────────
# 아래는 .env 에 넣지 말 것 — 측정 회차마다 셸에서 주입한다
# (.env 는 배포마다 덮어써지므로 여기 두면 사라진다)
#
#   LOADTEST_SEED_ENABLED=true \
#   LOADTEST_SEED_USER_COUNT=500 \
#   sudo -E docker compose up -d Blue
#
# LOADTEST_SEED_ENABLED       기본 false — true 일 때만 시더 빈이 등록된다
# LOADTEST_SEED_USER_COUNT    기본 0
# LOADTEST_SEED_EMAIL_DOMAIN  기본 loadtest.invalid (RFC 6761 예약 TLD)
# LOADTEST_SEED_PASSWORD      기본 loadtest1234!
# ─────────────────────────────────────────────────────────────
